# NEMU configuration target: riscv64-xs-clang
#
# A target is a stack of configuration layers merged in order; the last
# definition of a symbol wins.  See configs/README.md.  Compose with:
#   make riscv64-xs-clang_defconfig
#
# fragment: riscv64/xs/base.config
# fragment: fragments/toolchain/clang.config
#
# Target-specific overrides.
# CONFIG_CC_O3 is not set
CONFIG_CC_OPT_FLAGS="-Wno-error=invalid-feature-combination"
# CONFIG_HAS_FLASH is not set
# CONFIG_MDT_INIT is not set
CONFIG_NMIE_INIT=y
# CONFIG_RESET_FROM_MMIO is not set
# CONFIG_RV_PMA_ENTRY_32 is not set
CONFIG_RV_PMP_ACTIVE_NUM=16
# CONFIG_RV_PMP_ENTRY_64 is not set
