# NEMU configuration target: riscv64-xs-diff-spike
#
# A target is a composition manifest, not a .config: it lists configuration
# layers that are merged in order (the last definition of a symbol wins).
# See configs/README.md.  Compose and install with:
#   make riscv64-xs-diff-spike_defconfig
#
# layer: riscv64/xs/sim.config
# layer: fragments/difftest/spike.config
#
# Target-specific overrides.
# CONFIG_AMO_AC_SOFT is not set
# CONFIG_CC_NATIVE_ARCH is not set
# CONFIG_CC_O3 is not set
# CONFIG_HAS_FLASH is not set
# CONFIG_MDT_INIT is not set
# CONFIG_MMIO_AC_SOFT is not set
CONFIG_MSIZE=0x400000000
CONFIG_NMIE_INIT=y
# CONFIG_RESET_FROM_MMIO is not set
# CONFIG_RVV_AGNOSTIC is not set
# CONFIG_RV_PMA_ENTRY_32 is not set
CONFIG_RV_PMP_ACTIVE_NUM=16
# CONFIG_RV_PMP_ENTRY_64 is not set
# CONFIG_RV_SHLCOFIDELEG is not set
# CONFIG_RV_SMCSRIND is not set
CONFIG_RV_ZFH=y
CONFIG_ZSTD_COMPRESS=y
