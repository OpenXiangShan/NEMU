# NEMU configuration board variant: riscv64/xs/ahead
#
# Turns the XiangShan reference board into the 'ahead' board: 8 GiB at
# 0x200000000, 40-bit address, UARTLITE/VGA, light QS, branch log, -O0.
#
# Applied by the targets after riscv64/xs/base.config.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
# CONFIG_AC_NONE is not set
CONFIG_BR_LOG=y
CONFIG_CC_DEBUG=y
CONFIG_CC_O0=y
# CONFIG_CC_O3 is not set
# CONFIG_CUSTOM_XVEXP2 is not set
# CONFIG_GUIDED_TVAL is not set
# CONFIG_HAS_FLASH is not set
CONFIG_HAS_UARTLITE=y
CONFIG_HAS_VGA=y
# CONFIG_LARGE_COPY is not set
CONFIG_LIGHTQS=y
CONFIG_MSIZE=0x200000000
CONFIG_PADDRBITS=40
# CONFIG_RESET_FROM_MMIO is not set
# CONFIG_RV_CBO is not set
# CONFIG_RV_CSR_TIME is not set
# CONFIG_RV_PMA_ENTRY_32 is not set
CONFIG_RV_PMP_ACTIVE_NUM=16
# CONFIG_RV_PMP_ENTRY_64 is not set
# CONFIG_RV_SDTRIG is not set
# CONFIG_RV_SMCNTRPMF is not set
# CONFIG_RV_SMCSRIND is not set
# CONFIG_RV_SMMPM is not set
# CONFIG_RV_SMNPM is not set
# CONFIG_RV_SMRNMI is not set
# CONFIG_RV_SMSTATEEN is not set
# CONFIG_RV_SSCOFPMF is not set
# CONFIG_RV_SSNPM is not set
# CONFIG_RV_SSTC is not set
# CONFIG_RV_SV48 is not set
# CONFIG_RV_SVNAPOT is not set
# CONFIG_RV_SVPBMT is not set
# CONFIG_RV_ZCB is not set
# CONFIG_RV_ZCMOP is not set
# CONFIG_RV_ZFA is not set
# CONFIG_RV_ZFH is not set
# CONFIG_RV_ZIMOP is not set
# CONFIG_TVAL_EX_II is not set
# CONFIG_UARTLITE_ASSERT_FOUR is not set
# CONFIG_USE_XS_ARCH_CSRS is not set
CONFIG_VECTOR_AC_SOFT=y
