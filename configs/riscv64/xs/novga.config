# NEMU machine profile: riscv64/xs/novga
#
# Machine profile: a complete configuration (delta from the Kconfig
# defaults).  Merge it first; fragments may override it.
#
# Lean XiangShan machine without VGA.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
CONFIG_CLINT_MMIO=0x38000000
# CONFIG_DETERMINISTIC is not set
# CONFIG_HAS_AUDIO is not set
# CONFIG_HAS_DISK is not set
CONFIG_HAS_UARTLITE=y
# CONFIG_HAS_VGA is not set
CONFIG_ISA_riscv64=y
# CONFIG_MEM_RANDOM is not set
CONFIG_MSIZE=0x200000000
CONFIG_PC_RESET_OFFSET=0x0
CONFIG_RESERVATION_SET_WIDTH=6
# CONFIG_RVV is not set
CONFIG_RV_ZABHA=y
CONFIG_RV_ZACAS=y
CONFIG_RV_ZAWRS=y
CONFIG_SDCARD_CTL_MMIO=0x40002000
CONFIG_UARTLITE_MMIO=0x40600000
CONFIG_ZSTD_COMPRESS=y
