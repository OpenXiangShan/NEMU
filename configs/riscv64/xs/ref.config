# NEMU configuration board variant: riscv64/xs/ref
#
# Turns the XiangShan simulation base into the difftest reference board:
# no peripherals, shared library with store log and guided execution.
#
# Applied by the targets after riscv64/xs/base.config.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
# CONFIG_CC_NATIVE_ARCH is not set
CONFIG_CUSTOM_XVEXP2=y
CONFIG_CUSTOM_XVEXP2_BF16=y
CONFIG_GEILEN=5
CONFIG_GUIDED_TVAL=y
# CONFIG_HAS_KEYBOARD is not set
# CONFIG_HAS_PLIC is not set
# CONFIG_HAS_SDCARD is not set
# CONFIG_HAS_UART16550 is not set
# CONFIG_HAS_UARTLITE is not set
# CONFIG_HAS_VGA is not set
CONFIG_LARGE_COPY=y
CONFIG_RV_AIA=y
CONFIG_RV_IMSIC=y
CONFIG_RV_SMCDELEG=y
CONFIG_RV_ZFH=y
CONFIG_SHARE=y
CONFIG_STORE_LOG=y
