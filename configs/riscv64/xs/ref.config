# Shared REF mode; version-specific exceptions are applied afterwards.

CONFIG_CUSTOM_XVEXP2=y
CONFIG_CUSTOM_XVEXP2_BF16=y
CONFIG_GEILEN=5
CONFIG_GUIDED_TVAL=y
# CONFIG_HAS_KEYBOARD is not set
# CONFIG_HAS_SDCARD is not set
# CONFIG_HAS_UART16550 is not set
# CONFIG_HAS_VGA is not set
CONFIG_LARGE_COPY=y
CONFIG_RV_AIA=y
CONFIG_RV_IMSIC=y
CONFIG_RV_SMCDELEG=y
CONFIG_RV_ZFH=y
CONFIG_SHARE=y
CONFIG_STORE_LOG=y
