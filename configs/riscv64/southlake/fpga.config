# NEMU configuration board variant: riscv64/southlake/fpga
#
# Turns the SouthLake base into the FPGA board: UART_SNPS, PLIC at
# 0x1f1c000000, reset through the MMIO reset vector.
#
# Applied by the targets after riscv64/southlake/base.config.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
CONFIG_HAS_PLIC=y
# CONFIG_HAS_UARTLITE is not set
CONFIG_HAS_UART_SNPS=y
CONFIG_PLIC_ADDRESS=0x1f1c000000
CONFIG_UART_SNPS_MMIO=0x1f00050000
