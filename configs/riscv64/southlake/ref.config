# NEMU machine profile: riscv64/southlake/ref
#
# Machine profile: a complete configuration (delta from the Kconfig
# defaults).  Merge it first; fragments may override it.
#
# SouthLake difftest reference machine.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
CONFIG_CC_DEBUG=y
CONFIG_CLINT_MMIO=0x38000000
# CONFIG_DETERMINISTIC is not set
CONFIG_FLASH_PRESET_CONTENT="0x0010029b,0x02529293,0x00028067"
CONFIG_FLASH_SIZE=0x80000
CONFIG_FLASH_START_ADDR=0x1ffff80000
# CONFIG_HAS_AUDIO is not set
# CONFIG_HAS_DISK is not set
CONFIG_HAS_FLASH=y
# CONFIG_HAS_KEYBOARD is not set
# CONFIG_HAS_SDCARD is not set
# CONFIG_HAS_TIMER is not set
# CONFIG_HAS_UART16550 is not set
CONFIG_ISA_riscv64=y
CONFIG_LARGE_COPY=y
CONFIG_MBASE=0x2000000000
# CONFIG_MEM_RANDOM is not set
CONFIG_MMIO_RESET_VECTOR=0x1ffff80000
CONFIG_MSIZE=0x200000000
CONFIG_PADDRBITS=38
CONFIG_PC_RESET_OFFSET=0x0
CONFIG_RESET_FROM_MMIO=y
# CONFIG_RVV is not set
CONFIG_RV_SDEXT=y
CONFIG_RV_SDTRIG=y
CONFIG_SHARE=y
CONFIG_TDATA1_MCONTROL6=y
CONFIG_USE_XS_ARCH_CSRS=y
