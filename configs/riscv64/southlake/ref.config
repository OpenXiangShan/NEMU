# NEMU configuration board variant: riscv64/southlake/ref
#
# Turns the SouthLake base into the difftest reference board: VGA only (no
# UART/PLIC), shared library, 38-bit physical address.
#
# Applied by the targets after riscv64/southlake/base.config.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
CONFIG_CC_DEBUG=y
CONFIG_CLINT_MMIO=0x38000000
# CONFIG_HAS_TIMER is not set
# CONFIG_HAS_UART16550 is not set
# CONFIG_HAS_UARTLITE is not set
CONFIG_HAS_VGA=y
CONFIG_LARGE_COPY=y
CONFIG_PADDRBITS=38
CONFIG_RV_SDEXT=y
CONFIG_RV_SDTRIG=y
CONFIG_SHARE=y
CONFIG_TDATA1_MCONTROL6=y
CONFIG_USE_XS_ARCH_CSRS=y
