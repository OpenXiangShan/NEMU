# NEMU configuration board variant: riscv64/gem5/ci
#
# Turns the GEM5 reference base into the GEM5 CI reference: adds the
# extension set the CI images expect.
#
# Applied by the targets after riscv64/gem5/base.config.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
# CONFIG_DIFFTEST_CHECK_SDTRIG is not set
CONFIG_GEILEN=5
CONFIG_GUIDED_TVAL=y
CONFIG_RV_AIA=y
CONFIG_RV_CBO=y
CONFIG_RV_IMSIC=y
CONFIG_RV_SDTRIG=y
CONFIG_RV_SMCSRIND=y
CONFIG_RV_SMMPM=y
CONFIG_RV_SMNPM=y
CONFIG_RV_SMSTATEEN=y
CONFIG_RV_SSNPM=y
CONFIG_RV_SSTC=y
CONFIG_RV_SV48=y
CONFIG_RV_SVNAPOT=y
CONFIG_RV_SVPBMT=y
CONFIG_RV_ZACAS=y
CONFIG_RV_ZAWRS=y
CONFIG_RV_ZCMOP=y
CONFIG_RV_ZFA=y
CONFIG_RV_ZFH=y
CONFIG_RV_ZIMOP=y
CONFIG_TDATA1_MCONTROL6=y
CONFIG_TRIGGER_NUM=4
CONFIG_TVAL_EX_II=y
