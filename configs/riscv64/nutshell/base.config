# NEMU configuration board base: riscv64/nutshell
#
# NutShell board: 2 GiB at 0x80000000, UARTLITE, flash, no FPU.
#
# Board variants and feature fragments are applied on top of this file;
# the ISA baseline is included below.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
# fragment: ../isa.config
#
# CONFIG_CC_LTO is not set
CONFIG_CLINT_MMIO=0x38000000
# CONFIG_DETERMINISTIC is not set
CONFIG_FLASH_PRESET_CONTENT="0x0010029b,0x01f29293,0x00028067"
CONFIG_FPU_NONE=y
# CONFIG_HAS_AUDIO is not set
# CONFIG_HAS_DISK is not set
CONFIG_HAS_FLASH=y
# CONFIG_HAS_KEYBOARD is not set
# CONFIG_HAS_SDCARD is not set
CONFIG_HAS_UARTLITE=y
# CONFIG_HAS_VGA is not set
# CONFIG_MEM_RANDOM is not set
CONFIG_MSIZE=0x80000000
CONFIG_PADDRBITS=32
CONFIG_RESET_FROM_MMIO=y
# CONFIG_RVB is not set
# CONFIG_RVH is not set
# CONFIG_RVK is not set
# CONFIG_RV_CSR_MCOUNTINHIBIT is not set
# CONFIG_RV_CSR_MSECCFG is not set
# CONFIG_RV_DEBUG is not set
CONFIG_RV_PMA_ENTRY_0=y
CONFIG_RV_PMP_ENTRY_0=y
# CONFIG_RV_SVINVAL is not set
# CONFIG_RV_ZICNTR is not set
# CONFIG_RV_ZICOND is not set
# CONFIG_RV_ZIHPM is not set
CONFIG_UARTLITE_MMIO=0x40600000
