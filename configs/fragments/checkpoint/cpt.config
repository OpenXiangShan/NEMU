# NEMU configuration layer: fragments/checkpoint/cpt
#
# Checkpoint-taking capability: compress checkpoint images with ZSTD.
# Machine-side changes (no flash/reset, smaller PMP/PMA, no SDTRIG) live
# in the machine profile or in the target overrides.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
CONFIG_ZSTD_COMPRESS=y
