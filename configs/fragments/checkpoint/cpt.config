# NEMU configuration layer: fragments/checkpoint/cpt
#
# Feature fragment.  Merged on top of a base.  It only carries the settings
# that every target using it agrees on; the rest stays in the target.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
# CONFIG_CC_O3 is not set
# CONFIG_HAS_FLASH is not set
CONFIG_NMIE_INIT=y
# CONFIG_RESET_FROM_MMIO is not set
# CONFIG_RVV_AGNOSTIC is not set
# CONFIG_RV_PMA_ENTRY_32 is not set
CONFIG_RV_PMP_ACTIVE_NUM=16
# CONFIG_RV_PMP_ENTRY_64 is not set
# CONFIG_RV_SDTRIG is not set
# CONFIG_RV_SMCSRIND is not set
# CONFIG_RV_SMDBLTRP is not set
# CONFIG_RV_SSDBLTRP is not set
CONFIG_ZSTD_COMPRESS=y
