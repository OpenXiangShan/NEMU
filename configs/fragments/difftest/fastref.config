# NEMU configuration layer: fragments/difftest/fastref
#
# Fast shared-reference execution: FAST_REF + PERF_OPT_SHARE, store log
# hash and instruction-boundary counting.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
CONFIG_BB_LIST_SIZE=1024
CONFIG_BB_POOL_SIZE=1024
CONFIG_FAST_REF=y
CONFIG_INSTR_CNT_BY_INSTR_PERF_OPT=y
CONFIG_PERF_OPT_SHARE=y
CONFIG_STORE_LOG_HASH=y
CONFIG_TCACHE_SIZE=8192
