# NEMU configuration layer: fragments/difftest/ctrl
#
# Feature fragment.  Merged on top of a base.  It only carries the settings
# that every target using it agrees on; the rest stays in the target.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
# CONFIG_CC_NATIVE_ARCH is not set
CONFIG_CLINT_LOCAL_TIMER_INTERRUPT=y
# CONFIG_DIFFTEST_STORE_COMMIT is not set
# CONFIG_GUIDED_EXEC is not set
# CONFIG_MDT_INIT is not set
CONFIG_NMIE_INIT=y
# CONFIG_QUERY_REF is not set
# CONFIG_RESET_FROM_MMIO is not set
# CONFIG_RT_CHECK is not set
# CONFIG_RV_PMA_CHECK is not set
# CONFIG_RV_PMP_CHECK is not set
# CONFIG_RV_SMCNTRPMF is not set
# CONFIG_RV_ZABHA is not set
CONFIG_SHARE=y
CONFIG_SHARE_CTRL=y
