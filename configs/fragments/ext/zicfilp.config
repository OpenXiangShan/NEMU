# NEMU configuration layer: fragments/ext/zicfilp
#
# Feature fragment.  Merged on top of a base.  It only carries the settings
# that every target using it agrees on; the rest stays in the target.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
# CONFIG_RV_ZABHA is not set
CONFIG_RV_ZICFILP=y
