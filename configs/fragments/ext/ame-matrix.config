# NEMU configuration layer: fragments/ext/ame-matrix
#
# Feature fragment.  Merged on top of a base.  It only carries the settings
# that every target using it agrees on; the rest stays in the target.
#
# Syntax: same as .config.  Later definitions of a symbol win.
#
CONFIG_CUSTOM_XVEXP2=y
CONFIG_CUSTOM_XVEXP2_BF16=y
CONFIG_RV_AME=y
CONFIG_RV_ZFBF_MIN=y
CONFIG_RV_ZFH=y
CONFIG_RV_ZVFBF_MIN=y
CONFIG_RV_ZVFBF_WMA=y
